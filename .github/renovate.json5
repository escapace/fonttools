{
  extends: [
    'github>escapace/renovate-configuration',
  ],
  enabledManagers: [
    'npm',
    'pep621',
  ],
  packageRules: [
    {
      enabled: false,
      matchManagers: [
        'pep621',
      ],
    },
    {
      enabled: true,
      matchManagers: [
        'pep621',
      ],
      matchPackageNames: [
        'fonttools',
        'unicodedata2',
      ],
      rangeStrategy: 'pin',
    },
  ],
}
